# ============================================================================
# A YUNA — configuracao. Copie para .env e preencha.
# ============================================================================

# --- quem ela e -------------------------------------------------------------
PROJECT_NAME=Yuna
CAST=yuna
SPRITE_PREFIXO=yuna

# --- as chaves (NUNCA committar) --------------------------------------------
ANTHROPIC_API_KEY=
YUNA_SOL_KEYPAIR=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_CTX_YUNA=

# --- a jornada --------------------------------------------------------------
# 16 horas acordada, 8 dormindo. Fora da janela: zero chamada de API.
REST_ENABLED=1
ACTIVE_START_HOUR=8
ACTIVE_END_HOUR=0
# 50 minutos de trabalho, 10 que sao dela
BREAK_MINUTES=10
# uma hora por dia so pra desenhar
DRAW_HOUR=20

# --- dinheiro ---------------------------------------------------------------
# Tudo real. Os tetos existem porque erro custa dinheiro de verdade.
REAL_TRADING=1
LIVE_TRADE=1
TRADING_ENABLED=1
MAX_REAL_TRADE_USD=2
MAX_TX_SOL=0.05

# --- callouts ---------------------------------------------------------------
CALLOUTS_ENABLED=1
CALLOUTS_PER_HOUR=5
CALLOUT_STAKE_USD=1
CALLOUT_PUBLICAR=1

# --- o que ela NAO tem ------------------------------------------------------
# Sem banco, sem servicos de encomenda, sem X por enquanto. Aluguel e placar:
# ela ve a conta do dia, mas ninguem despeja ninguem.
BANK_ENABLED=0
SERVICES_ENABLED=0
X_ENABLED=0
RENT_MODE=placar
HOUSE_BASE_DAILY_USD=12

# --- estado (no Railway, aponte para o volume) ------------------------------
STATE_FILE=src/data/state-yuna.json
CHECKPOINT_FILE=src/data/checkpoint-yuna.json

# --- o atelie (so na maquina com GPU; no Railway deixe vazio) ---------------
ATELIER_DIR=
